# ==============================================================================
# DSA AutoGen - Multi-Agent Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported: OpenAI, Azure OpenAI, Ollama, DeepSeek, Groq, Gemini (OpenAI compat)
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Set base URL for local models (Ollama: http://localhost:11434/v1) or alternative providers
OPENAI_BASE_URL=
TEMPERATURE=0.1

# Execution & Self-Healing Budget
MAX_RETRIES=3
EXECUTION_TIMEOUT_SEC=8.0

# C++ Compiler Configuration
# Auto-discovered across PATH (g++, clang++, cl)
# On Windows with MSYS2: C:\msys64\mingw64\bin\g++.exe
CPP_COMPILER=g++
CPP_STANDARD=c++17
CPP_OPT_LEVEL=-O2

# Workspace Directory for Temporary Build & Execution Files
DSA_WORKSPACE_DIR=./.dsa_workspace

